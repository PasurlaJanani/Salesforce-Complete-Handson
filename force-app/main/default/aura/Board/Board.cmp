<aura:component implements="flexipage:availableForAllPageTypes">
<aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
<aura:handler name="render" value="{!this}" action="{!c.doRender}"/>
<aura:attribute name="Mode" type="String" access="public"/>
<aura:attribute name="Words" type="List" access="private"/>
<aura:attribute name="winWord" type="String" access="private"/>
<aura:attribute name="clickCount" type="Integer" default="0" access="private"/>
<aura:attribute name="blockSize" type="Integer" access="private"/>
<div class="board">
<lightning:layout >
    <div class="slds-text-heading--medium">
    <lightning:layoutItem size="" padding="around-small">WORD :<span class="winword">{!v.winWord} </span> </lightning:layoutItem>
    </div>
    <div class="slds-text-heading--medium">
    <lightning:layoutItem size="" padding="around-small">Moves Left : {!(3-v.clickCount)}</lightning:layoutItem>
    </div>
</lightning:layout>
<lightning:layout multipleRows="true">
    <aura:iteration items="{!v.Words}" var="word">
         <lightning:layoutItem size="{!v.blockSize}" padding="around-small">{!word}</lightning:layoutItem>
         <c:Block Label="{!word}"></c:Block>
    </aura:iteration>
</lightning:layout>
</div>
</aura:component>